<?xml version="1.0" encoding="utf-8"?>
<!-- 3D 压感次按钮:抬升表面色 + 深色底缘 -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <layer-list>
            <item android:gravity="bottom" android:height="2dp">
                <shape><solid android:color="@color/launcher_edge" /></shape>
            </item>
            <item android:bottom="2dp">
                <shape>
                    <solid android:color="@color/launcher_card_pressed" />
                    <corners android:radius="14dp" />
                </shape>
            </item>
        </layer-list>
    </item>
    <item>
        <layer-list>
            <item android:gravity="bottom" android:height="4dp">
                <shape>
                    <solid android:color="@color/launcher_edge" />
                    <corners android:radius="14dp" />
                </shape>
            </item>
            <item android:bottom="4dp">
                <shape>
                    <solid android:color="@color/launcher_card" />
                    <corners android:radius="14dp" />
                </shape>
            </item>
        </layer-list>
    </item>
</selector>
