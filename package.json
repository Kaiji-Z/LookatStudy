{
  "name": "lookatstudy",
  "version": "0.1.0",
  "private": true,
  "description": "Open-source, local-first, AI-driven learning platform. Turn any GitHub repo into a Duolingo-style course you can actually finish.",
  "license": "MIT",
  "author": "LookatStudy Contributors",
  "main": "dist-electron/main/index.js",
  "scripts": {
    "dev": "vite",
    "dev:electron": "concurrently -k \"npm:dev:vite\" \"npm:dev:electron:wait\"",
    "dev:vite": "vite",
    "dev:electron:wait": "wait-on http://localhost:5173/ && cross-env NODE_ENV=development electron .",
    "build": "vite build",
    "build:electron": "vite build",
    "start": "vite build && electron .",
    "dist": "vite build && electron-builder",
    "self-test": "vite build && electron . --self-test",
    "ui-test": "vite build && electron . --ui-test --no-sandbox",
    "preview": "vite preview",
    "lint": "oxlint .",
    "test": "vitest",
    "verify:core": "node scripts/verify-db.mjs && tsx scripts/verify-srs.mjs && tsx scripts/verify-streak.mjs && tsx scripts/verify-flags.mjs && tsx scripts/verify-progress.mjs && tsx scripts/verify-skills.mjs && tsx scripts/verify-bkt.mjs && tsx scripts/verify-proposals.mjs && tsx scripts/verify-llm-presets.mjs && tsx scripts/verify-rag-memory.mjs && tsx scripts/verify-dashboard.mjs && tsx scripts/verify-markdown-course.mjs && tsx scripts/verify-course-generator.mjs && tsx scripts/verify-exercises.mjs && tsx scripts/verify-repo-fetcher.mjs && tsx scripts/verify-starter-prompts.mjs && tsx scripts/verify-xp.mjs"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^2.0.0",
    "@ai-sdk/google": "^2.0.0",
    "@ai-sdk/openai": "^2.0.0",
    "@modelcontextprotocol/sdk": "^1.0.0",
    "@tanstack/react-query": "^5.62.0",
    "ai": "^5.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.38.0",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^9.0.1",
    "remark-gfm": "^4.0.0",
    "sql.js": "^1.12.0",
    "tailwind-merge": "^2.6.0",
    "zod": "^3.24.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/sql.js": "^1.4.9",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.0",
    "cross-env": "^7.0.3",
    "drizzle-kit": "^0.30.0",
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.16",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^6.0.0",
    "vite-plugin-electron": "^0.29.0",
    "vite-plugin-electron-renderer": "^0.14.6",
    "vitest": "^2.1.8",
    "wait-on": "^8.0.1"
  },
  "engines": {
    "node": ">=20"
  }
}
